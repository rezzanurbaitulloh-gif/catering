# Salin ke .env.local lalu isi nilai aslinya. JANGAN commit .env.local.
# .env.local sudah diabaikan git via root .gitignore (.env*).
NEXT_PUBLIC_SUPABASE_URL=https://okrnrxqojlugzwsdkczv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-anon-key-here

# KUNCI OPSIONAL, HANYA SERVER (tanpa prefix NEXT_PUBLIC_, tidak pernah ke browser).
# Dibutuhkan oleh route privat: /api/track, /api/account, /api/quotes/[id]/approve,
# GET /api/capabilities, dan halaman /penawaran/[id] — karena policy RLS saat ini
# hanya mengizinkan anon: select katalog publik + insert inquiries/complaints.
# Tanpa ini, route privat menjawab 503 dengan pesan jujur (tanpa data palsu).
# Minta ke koordinator dan simpan hanya di server/Vercel env, jangan commit.
# SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here

# Base URL publik situs ini (untuk sitemap & Open Graph absolut)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
