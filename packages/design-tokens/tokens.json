{
  "brand": {
    "name": "Rasa Nusantara Catering",
    "voice": "premium hospitality, editorial, cinematic — never generic SaaS",
    "avoid": ["purple gradients", "glassmorphism", "blobs", "giant centered hero + three cards", "AI-looking layouts"]
  },
  "color": {
    "ink": "#1C1917",
    "cream": "#FAF7F2",
    "paper": "#FFFFFF",
    "gold": "#B45309",
    "goldSoft": "#F5E6C8",
    "leaf": "#3F6212",
    "clay": "#9A3412",
    "line": "#E7E0D4",
    "muted": "#78716C",
    "danger": "#B91C1C",
    "warning": "#B45309",
    "success": "#15803D",
    "night": "#141210"
  },
  "type": {
    "display": "Fraunces, Georgia, serif",
    "body": "Inter, system-ui, sans-serif",
    "scale": { "hero": 44, "h1": 32, "h2": 24, "body": 16, "small": 14 }
  },
  "space": { "touch": 44, "radius": 14, "gutter": 16 },
  "status": {
    "PLANNING": "#78716C",
    "LOCKED": "#1D4ED8",
    "IN_PREPARATION": "#B45309",
    "IN_TRANSIT": "#7C3AED",
    "SETUP": "#C2410C",
    "SERVICE": "#15803D",
    "BREAKDOWN": "#0E7490",
    "COMPLETED": "#3F6212",
    "CLOSED": "#44403C",
    "HIGH": "#B91C1C",
    "MEDIUM": "#B45309",
    "LOW": "#15803D"
  }
}
